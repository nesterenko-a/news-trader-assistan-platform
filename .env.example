# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/newstrader

# Схема управляется Liquibase (docker compose up migrations).
# AUTO_CREATE_SCHEMA=false в продакшене, чтобы приложение не создавало таблицы само.
AUTO_CREATE_SCHEMA=true

# LLM (DeepSeek, OpenAI-совместимый API)
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-reasoner

# MOEX ISS
MOEX_BASE_URL=https://iss.moex.com/iss

# Telegram (опционально, для бота и каналов)
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Telegram-каналы как источник новостей (через запятую, без @)
# Пример: TELEGRAM_CHANNELS=markettwits,bcs_express
TELEGRAM_CHANNELS=
# Имя файла сессии Telethon (создаётся после первого входа scripts/telegram_login.py)
TELEGRAM_SESSION_NAME=telethon_session

# Публичный адрес веб-интерфейса (ссылки в ответах Telegram-бота)
APP_URL=http://localhost:8000

# Список тикеров для MVP
MVP_TICKERS=AFLT,LKOH,GAZP,SBER,NLMK,CHMF,MAGN,PLZL,GMKN,RUAL,IRAO,HYDR,YDEX,VKCO,MGNT,FIVE,OZON,PHOR,URKA,AKRN,MTSS,RTKM,PIKK,LSRG,TRNFP,GLTR,AVAZ,KMAZ,MTLR,RASP
