<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">

    <changeSet id="0250-tech-analyses-price-at-analysis" author="newstrader">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="tech_analyses" columnName="price_at_analysis"/>
            </not>
        </preConditions>
        <addColumn tableName="tech_analyses">
            <column name="price_at_analysis" type="varchar(40)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
