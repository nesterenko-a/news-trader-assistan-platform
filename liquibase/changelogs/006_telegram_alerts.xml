<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">

    <changeSet id="033-user-telegram" author="newstrader">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="users" columnName="telegram_chat_id"/>
            </not>
        </preConditions>
        <addColumn tableName="users">
            <column name="telegram_chat_id" type="bigint"/>
        </addColumn>
    </changeSet>

    <changeSet id="034-telegram-link-codes" author="newstrader">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="telegram_link_codes"/>
            </not>
        </preConditions>
        <createTable tableName="telegram_link_codes">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="varchar(20)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="chat_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamptz" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
