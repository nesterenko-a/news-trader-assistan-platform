<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">

    <changeSet id="022-market-candles" author="newstrader">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="market_candles"/>
            </not>
        </preConditions>
        <createTable tableName="market_candles">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="security_id" type="bigint">
                <constraints foreignKeyName="fk_market_candles_security_id" references="securities(id)"/>
            </column>
            <column name="trading_date" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="open" type="double precision"/>
            <column name="high" type="double precision"/>
            <column name="low" type="double precision"/>
            <column name="close" type="double precision"/>
            <column name="volume" type="bigint" defaultValueNumeric="0"/>
        </createTable>
    </changeSet>

    <changeSet id="023-market-candles-unique" author="newstrader">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="ix_market_candles_security_date"/>
            </not>
        </preConditions>
        <addUniqueConstraint tableName="market_candles" columnNames="security_id, trading_date" constraintName="ix_market_candles_security_date"/>
    </changeSet>

    <changeSet id="024-market-candles-date-index" author="newstrader">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="ix_market_candles_trading_date"/>
            </not>
        </preConditions>
        <createIndex indexName="ix_market_candles_trading_date" tableName="market_candles">
            <column name="trading_date"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
