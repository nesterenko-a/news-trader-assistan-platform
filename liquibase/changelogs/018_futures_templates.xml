<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">

    <changeSet id="0180-futures-templates" author="newstrader">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="futures_templates"/>
            </not>
        </preConditions>
        <createTable tableName="futures_templates">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="tickers" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="0181-futures-templates-created-at-default" author="newstrader">
        <preConditions onFail="MARK_RAN">
            <not>
                <dbms type="h2"/>
            </not>
        </preConditions>
        <addDefaultValue tableName="futures_templates" columnName="created_at" defaultValueComputed="now()"/>
    </changeSet>

</databaseChangeLog>
