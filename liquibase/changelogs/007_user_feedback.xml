<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">

    <changeSet id="035-user-feedback" author="newstrader">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="user_feedback"/>
            </not>
        </preConditions>
        <createTable tableName="user_feedback">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="strategy_id" type="bigint">
                <constraints foreignKeyName="fk_uf_strategy" references="strategies(id)" nullable="false"/>
            </column>
            <column name="user_id" type="bigint">
                <constraints foreignKeyName="fk_uf_user" references="users(id)" nullable="false"/>
            </column>
            <column name="rating" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="comment" type="text" defaultValue=""/>
            <column name="created_at" type="timestamptz" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="user_feedback" columnNames="strategy_id, user_id" constraintName="uq_user_feedback_strategy_user"/>
        <createIndex indexName="ix_user_feedback_user_id" tableName="user_feedback">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
