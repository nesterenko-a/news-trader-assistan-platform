<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">

    <changeSet id="0140-source-category" author="newstrader">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="sources" columnName="category"/>
            </not>
        </preConditions>
        <addColumn tableName="sources">
            <column name="category" type="varchar(50)" defaultValue=""/>
        </addColumn>
    </changeSet>

    <changeSet id="0141-source-last-checked-at" author="newstrader">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="sources" columnName="last_checked_at"/>
            </not>
        </preConditions>
        <addColumn tableName="sources">
            <column name="last_checked_at" type="timestamptz"/>
        </addColumn>
    </changeSet>

    <changeSet id="0142-source-last-status" author="newstrader">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="sources" columnName="last_status"/>
            </not>
        </preConditions>
        <addColumn tableName="sources">
            <column name="last_status" type="varchar(10)"/>
        </addColumn>
    </changeSet>

    <changeSet id="0143-source-last-error" author="newstrader">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="sources" columnName="last_error"/>
            </not>
        </preConditions>
        <addColumn tableName="sources">
            <column name="last_error" type="varchar(500)"/>
        </addColumn>
    </changeSet>

    <changeSet id="0144-user-sources" author="newstrader">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="user_sources"/>
            </not>
        </preConditions>
        <createTable tableName="user_sources">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="bigint">
                <constraints foreignKeyName="fk_user_sources_user_id" references="users(id)" nullable="false"/>
            </column>
            <column name="source_id" type="bigint">
                <constraints foreignKeyName="fk_user_sources_source_id" references="sources(id)" nullable="false"/>
            </column>
            <column name="created_at" type="timestamptz" defaultValueComputed="now()"/>
        </createTable>
        <addUniqueConstraint tableName="user_sources" columnNames="user_id, source_id" constraintName="ix_user_sources_user_source"/>
        <createIndex indexName="ix_user_sources_source_id" tableName="user_sources">
            <column name="source_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
